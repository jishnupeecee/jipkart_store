<%- include('partials/header') %>

<div class="container">
  <div class="form-page">
    <h2>Create Account</h2>
    <p class="sub">Join JipKart as a customer or a seller</p>

    <% if (error) { %><div class="form-error"><%= error %></div><% } %>

    <form action="/register" method="POST">
      <div class="role-toggle">
        <label>
          <input type="radio" name="role" value="customer" <%= (!form.role || form.role === 'customer') ? 'checked' : '' %>>
          <span>🛒 I'm a Customer</span>
        </label>
        <label>
          <input type="radio" name="role" value="seller" <%= form.role === 'seller' ? 'checked' : '' %>>
          <span>🏪 I'm a Seller</span>
        </label>
      </div>

      <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="name" required value="<%= form.name || '' %>" placeholder="Your full name">
      </div>
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" required value="<%= form.email || '' %>" placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label>Phone Number</label>
        <input type="tel" name="phone" value="<%= form.phone || '' %>" placeholder="9876543210">
      </div>
      <div class="form-group" id="shopNameGroup">
        <label>Shop / Business Name (sellers only)</label>
        <input type="text" name="shopName" value="<%= form.shopName || '' %>" placeholder="e.g. Ravi Building Supplies">
      </div>
      <div class="form-group">
        <label>Address</label>
        <input type="text" name="address" value="<%= form.address || '' %>" placeholder="Street, Town, District">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" required placeholder="At least 6 characters">
      </div>
      <div class="form-group">
        <label>Confirm Password</label>
        <input type="password" name="confirmPassword" required placeholder="Re-enter password">
      </div>

      <button type="submit" class="btn btn-block">CREATE ACCOUNT</button>
    </form>

    <div class="form-footer">
      Already have an account? <a href="/login">Login here</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
