<%- include('partials/header') %>

<div class="container">
  <h2 class="page-title">My Cart</h2>

  <% if (items.length === 0) { %>
    <div class="empty-state">
      <div class="emoji">🛒</div>
      <h3>Your cart is empty</h3>
      <p class="page-sub">Browse our products and add items to your cart.</p>
      <a href="/products" class="btn">Start Shopping</a>
    </div>
  <% } else { %>
  <div class="cart-page">
    <div>
      <% items.forEach(item => { %>
        <div class="cart-item">
          <img src="<%= item.product.image %>" alt="<%= item.product.name %>">
          <div class="details">
            <h4><a href="/products/<%= item.product.id %>"><%= item.product.name %></a></h4>
            <div class="unit-label"><%= item.product.unit %> &middot; ₹<%= item.product.price %> each</div>
            <form action="/cart/update" method="POST">
              <input type="hidden" name="productId" value="<%= item.product.id %>">
              <label style="font-size:12.5px;">Qty:</label>
              <input type="number" name="qty" value="<%= item.qty %>" min="1" max="<%= item.product.stock %>" style="width:60px;padding:4px 8px;border:1px solid #e2e6e3;border-radius:5px;">
              <button type="submit" class="btn btn-sm btn-outline">Update</button>
            </form>
          </div>
          <div style="text-align:right;">
            <div class="price">₹<%= item.subtotal %></div>
            <form action="/cart/remove" method="POST">
              <input type="hidden" name="productId" value="<%= item.product.id %>">
              <button type="submit" class="remove-link">Remove</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="summary-box">
      <h3>Order Summary</h3>
      <div class="summary-row"><span>Items (<%= items.length %>)</span><span>₹<%= total %></span></div>
      <div class="summary-row"><span>Delivery</span><span>FREE</span></div>
      <div class="summary-row total"><span>Total</span><span>₹<%= total %></span></div>
      <a href="/checkout" class="btn btn-block">Proceed to Checkout</a>
    </div>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
