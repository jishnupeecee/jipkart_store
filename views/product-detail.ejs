<%- include('partials/header') %>

<div class="container">
  <div class="breadcrumb"><a href="/">Home</a> / <a href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a> / <%= product.name %></div>

  <div class="product-detail">
    <div class="main-image">
      <img src="<%= product.image %>" alt="<%= product.name %>">
    </div>
    <div>
      <span class="category-tag"><%= product.category %></span>
      <h1><%= product.name %></h1>

      <div class="price-block">
        <span class="price">₹<%= product.price %></span>
        <% if (product.mrp && product.mrp > product.price) { %><span class="mrp">₹<%= product.mrp %></span>
        <span class="badge badge-green" style="margin-left:8px;"><%= Math.round((1 - product.price/product.mrp) * 100) %>% OFF</span>
        <% } %>
        <span class="unit-label"><%= product.unit %></span>
      </div>

      <span class="stock-badge <%= product.stock === 0 ? 'stock-out' : (product.stock < 20 ? 'stock-low' : 'stock-ok') %>" style="font-size:13px;">
        <%= product.stock === 0 ? '❌ Out of stock' : (product.stock < 20 ? '⚠️ Only ' + product.stock + ' left in stock' : '✅ In stock') %>
      </span>

      <% if (seller) { %>
      <div class="seller-info">
        🏪 Sold by <b><%= seller.shopName || seller.name %></b>
      </div>
      <% } %>

      <% if (!user || user.role === 'customer') { %>
      <form action="/cart/add" method="POST">
        <input type="hidden" name="productId" value="<%= product.id %>">
        <div class="qty-row">
          <label>Quantity:</label>
          <div class="qty-selector">
            <button type="button" onclick="stepQty(-1)">−</button>
            <input type="number" name="qty" id="qtyInput" value="1" min="1" max="<%= product.stock %>">
            <button type="button" onclick="stepQty(1)">+</button>
          </div>
        </div>
        <div class="detail-actions">
          <button type="submit" class="btn" <%= product.stock === 0 ? 'disabled' : '' %>>🛒 Add to Cart</button>
        </div>
      </form>
      <% } else { %>
        <p class="page-sub">Log in as a customer to purchase this item.</p>
      <% } %>

      <div class="description-block">
        <h3>Product Description</h3>
        <p><%= product.description %></p>
      </div>
    </div>
  </div>

  <% if (related.length > 0) { %>
  <div class="section-heading">
    <h2>Related Products</h2>
  </div>
  <div class="product-grid">
    <% related.forEach(p => { %>
      <div class="product-card">
        <a href="/products/<%= p.id %>" class="thumb"><img src="<%= p.image %>" alt="<%= p.name %>"></a>
        <div class="info">
          <span class="cat-label"><%= p.category %></span>
          <a href="/products/<%= p.id %>"><h3><%= p.name %></h3></a>
          <div class="price-row">
            <span class="price">₹<%= p.price %></span>
            <span class="unit-label"><%= p.unit %></span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>
</div>

<script>
function stepQty(delta) {
  const input = document.getElementById('qtyInput');
  let val = parseInt(input.value) || 1;
  val = Math.max(1, val + delta);
  input.value = val;
}
</script>

<%- include('partials/footer') %>
