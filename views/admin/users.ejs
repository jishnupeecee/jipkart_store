<%- include('../partials/header') %>

<div class="container">
  <div class="dash-tabs">
    <a href="/admin/dashboard">Overview</a>
    <a href="/admin/products">Products</a>
    <a href="/admin/users" class="active">Users</a>
    <a href="/admin/orders">Orders</a>
  </div>

  <h2 class="page-title" style="margin-top:16px;">Manage Users (<%= users.length %>)</h2>

  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Name</th><th>Email</th><th>Role</th><th>Phone</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.name %><% if (u.shopName) { %><br><span style="color:#667066;font-size:12px;"><%= u.shopName %></span><% } %></td>
            <td><%= u.email %></td>
            <td>
              <span class="badge <%= u.role === 'admin' ? 'badge-blue' : (u.role === 'seller' ? 'badge-orange' : 'badge-green') %>"><%= u.role %></span>
            </td>
            <td><%= u.phone || '-' %></td>
            <td>
              <% if (u.role !== 'admin') { %>
              <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Delete this user? This cannot be undone.');">
                <button type="submit" class="btn btn-sm" style="background:#fdecec;color:#c02626;">Delete</button>
              </form>
              <% } else { %>
                <span style="color:#667066;font-size:12px;">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
