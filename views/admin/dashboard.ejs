<%- include('../partials/header') %>

<div class="container">
  <h2 class="page-title" style="margin-top:26px;">Admin Dashboard</h2>
  <p class="page-sub">Platform-wide overview</p>

  <div class="dash-tabs">
    <a href="/admin/dashboard" class="active">Overview</a>
    <a href="/admin/products">Products</a>
    <a href="/admin/users">Users</a>
    <a href="/admin/orders">Orders</a>
  </div>

  <div class="stat-grid">
    <div class="stat-card"><div class="label">Total Products</div><div class="value"><%= stats.productCount %></div></div>
    <div class="stat-card"><div class="label">Total Users</div><div class="value"><%= stats.userCount %></div></div>
    <div class="stat-card"><div class="label">Sellers</div><div class="value"><%= stats.sellerCount %></div></div>
    <div class="stat-card"><div class="label">Customers</div><div class="value"><%= stats.customerCount %></div></div>
    <div class="stat-card"><div class="label">Total Orders</div><div class="value"><%= stats.orderCount %></div></div>
    <div class="stat-card"><div class="label">Total Revenue</div><div class="value">₹<%= stats.totalRevenue %></div></div>
  </div>

  <div class="section-heading">
    <h2>Recent Orders</h2>
    <a href="/admin/orders">View All →</a>
  </div>

  <% if (recentOrders.length === 0) { %>
    <p class="page-sub">No orders placed yet.</p>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Order ID</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead>
      <tbody>
        <% recentOrders.forEach(o => { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= o.customerName %></td>
            <td>₹<%= o.total %></td>
            <td><span class="badge badge-orange"><%= o.status %></span></td>
            <td><%= new Date(o.createdAt).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
